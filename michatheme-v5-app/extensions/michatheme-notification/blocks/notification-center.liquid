{{ 'notification-center.css' | asset_url | stylesheet_tag }}
{%- comment -%}Gleicher Aufbau + gleiches Skript wie im Theme (theme/snippets/mt-notification.liquid), Icons lokal{%- endcomment -%}
<div class="mt-notification mt-notification--{{ block.settings.placement | handleize }}" data-mt-notification data-proxy-path="{{ block.settings.proxy_path | escape }}" data-app-api="1" data-limit="{{ block.settings.limit }}" data-label="Benachrichtigungen" data-label-unread="Benachrichtigungen, %s ungelesen" data-texts='{"readAll": "Alle gelesen", "hideRead": "Gelesene ausblenden", "hide": "Ausblenden", "hideLabel": "Meldung ausblenden: %s", "showAll": "Alle anzeigen", "showAllCount": "Alle anzeigen (%s)", "allTitle": "Alle Benachrichtigungen", "close": "Fenster schließen", "stateNew": "Neu", "stateRead": "Gelesen", "openLink": "Ansehen", "doneRead": "Alle Meldungen sind gelesen.", "doneHidden": "%s gelesene Meldungen ausgeblendet.", "error": "Das hat nicht geklappt. Bitte erneut versuchen.", "empty": "Keine neuen Benachrichtigungen."}' hidden>
  <button type="button" class="mt-notification__button" aria-expanded="false" aria-controls="mgd-app-notifications-{{ block.id }}" aria-label="Benachrichtigungen">
    <svg class="mt-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      {%- case block.settings.icon -%}
        {%- when 'bell-ring' -%}<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/><path d="M4 2C2.8 3.7 2 5.7 2 8"/><path d="M22 8c0-2.3-.8-4.3-2-6"/>
        {%- when 'bell-dot' -%}<path d="M19.4 14.9C20.2 16.4 21 17 21 17H3s3-2 3-9c0-3.3 2.7-6 6-6 .7 0 1.3.1 1.9.3"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/><circle cx="18" cy="8" r="3"/>
        {%- when 'megaphone' -%}<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>
        {%- when 'inbox' -%}<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>
        {%- when 'mail' -%}<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>
        {%- when 'message' -%}<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        {%- when 'info' -%}<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
        {%- when 'star' -%}<path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        {%- when 'sparkles' -%}<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/>
        {%- else -%}<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
      {%- endcase -%}
    </svg>
    <span class="mt-notification__count" data-mt-notification-count aria-hidden="true" hidden>0</span>
  </button>
  <div class="mt-notification__panel" id="mgd-app-notifications-{{ block.id }}" role="region" aria-label="Benachrichtigungen" hidden>
    <div class="mt-notification__head"><strong>Benachrichtigungen</strong><span class="mt-notification__tools"><button type="button" class="mt-notification__tool" data-mt-notification-read-all disabled>Alle gelesen</button><button type="button" class="mt-notification__tool" data-mt-notification-hide-read disabled>Gelesene ausblenden</button></span></div>
    <p class="mt-notification__status" data-mt-notification-status role="status" aria-live="polite"></p>
    <p class="mt-notification__empty" data-mt-notification-empty>Keine neuen Benachrichtigungen.</p>
    <ul class="mt-notification__list" data-mt-notification-list></ul>
    <button type="button" class="mt-notification__show-all" data-mt-notification-show-all aria-haspopup="dialog" hidden>Alle anzeigen</button>
  </div>
</div>
<script src="{{ 'notification-center.js' | asset_url }}" defer></script>
{% schema %}{"name": "MichaThemeV5 Notifications", "target": "section", "settings": [{"type": "select", "id": "placement", "label": "Platzierung", "default": "floating-bottom-right", "options": [{"value": "menu", "label": "Menü"}, {"value": "footer", "label": "Footer"}, {"value": "floating-bottom-right", "label": "Schwebend unten rechts"}, {"value": "floating-bottom-left", "label": "Schwebend unten links"}]}, {"type": "range", "id": "limit", "label": "Anzahl im Panel", "min": 1, "max": 30, "step": 1, "default": 5}, {"type": "select", "id": "icon", "label": "Icon der Glocke", "default": "bell", "options": [{"value": "bell", "label": "Glocke"}, {"value": "bell-ring", "label": "Glocke mit Klang"}, {"value": "bell-dot", "label": "Glocke mit Punkt"}, {"value": "megaphone", "label": "Megafon"}, {"value": "inbox", "label": "Posteingang"}, {"value": "mail", "label": "Brief"}, {"value": "message", "label": "Sprechblase"}, {"value": "info", "label": "Info"}, {"value": "star", "label": "Stern"}, {"value": "sparkles", "label": "Neuigkeiten"}]}, {"type": "text", "id": "proxy_path", "label": "App-Proxy-Pfad", "default": "/apps/michatheme-notifications"}]}{% endschema %}
