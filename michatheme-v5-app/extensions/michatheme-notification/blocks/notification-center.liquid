{{ 'notification-center.css' | asset_url | stylesheet_tag }}
<div class="mgd-notification-center mgd-notification-center--{{ block.settings.placement }}" data-mgd-notification-center data-proxy-path="{{ block.settings.proxy_path | escape }}" data-app-api="1"><button type="button" class="mgd-notification-center__button" aria-expanded="false" aria-controls="mgd-app-notifications-{{ block.id }}" aria-label="Benachrichtigungen öffnen"><span aria-hidden="true">🔔</span><span class="mgd-notification-center__count" hidden>0</span></button><section id="mgd-app-notifications-{{ block.id }}" class="mgd-notification-center__panel" hidden aria-label="Benachrichtigungen"><p class="mgd-notification-center__empty">Keine neuen Benachrichtigungen.</p><ul></ul></section></div>
<script src="{{ 'notification-center.js' | asset_url }}" defer></script>
{% schema %}{"name":"MichaThemeV5 Notifications","target":"section","settings":[{"type":"select","id":"placement","label":"Platzierung","default":"floating-bottom-right","options":[{"value":"menu","label":"Menü"},{"value":"footer","label":"Footer"},{"value":"floating-bottom-right","label":"Schwebend unten rechts"},{"value":"floating-bottom-left","label":"Schwebend unten links"}]},{"type":"text","id":"proxy_path","label":"App-Proxy-Pfad","default":"/apps/michatheme-notifications"}]}{% endschema %}
