{% comment %}Brotkrümel sichtbar + BreadcrumbList JSON-LD, Startseite > Kategorie/Blog > aktuelle Seite{% endcomment %}
{%- assign mt_parent_title = '' -%}
{%- assign mt_parent_url = '' -%}
{%- assign mt_current = '' -%}
{%- case request.page_type -%}
  {%- when 'product' -%}
    {%- assign mt_current = product.title -%}
    {%- if collection -%}
      {%- assign mt_parent_title = collection.title -%}
      {%- assign mt_parent_url = collection.url -%}
    {%- endif -%}
  {%- when 'collection' -%}
    {%- assign mt_current = collection.title -%}
  {%- when 'page' -%}
    {%- assign mt_current = page.title -%}
  {%- when 'blog' -%}
    {%- assign mt_current = blog.title -%}
  {%- when 'article' -%}
    {%- assign mt_current = article.title -%}
    {%- assign mt_parent_title = blog.title -%}
    {%- assign mt_parent_url = blog.url -%}
{%- endcase -%}
{%- if mt_current != blank -%}
  {%- if settings.mt_seo_breadcrumbs -%}
    <nav class="mt-breadcrumbs mt-container" aria-label="{{ 'general.breadcrumbs' | t | escape }}">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
        {%- if mt_parent_title != blank -%}
          <li><a href="{{ mt_parent_url }}">{{ mt_parent_title | escape }}</a></li>
        {%- endif -%}
        <li><span aria-current="page">{{ mt_current | escape }}</span></li>
      </ol>
    </nav>
  {%- endif -%}
  {%- if settings.mt_seo_jsonld -%}
    {%- assign mt_pos = 2 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} }
          {%- if mt_parent_title != blank -%}
            {%- assign mt_pos = 3 -%}
            ,{ "@type": "ListItem", "position": 2, "name": {{ mt_parent_title | json }}, "item": {{ request.origin | append: mt_parent_url | json }} }
          {%- endif %},
          { "@type": "ListItem", "position": {{ mt_pos | json }}, "name": {{ mt_current | json }}, "item": {{ canonical_url | json }} }
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}
