{% comment %}
  Preis + Pflichtangaben. Params: product, variant (optional), show_from (ab-Preis)
  Hinweis inkl./zzgl. MwSt. aus cart.taxes_included, eigener Text ersetzt das - Versandkosten-Link bleibt immer
  kein Grundpreis bei ab-Preis (gilt nur je Variante)
  niedrigster Preis 30 Tage > Metafeld mt.lowest_price_30 (Variante vor Produkt), Shopify hat keine Preishistorie
  technischer Hinweis, keine Rechtsberatung
{% endcomment %}
{%- assign mt_variant = variant | default: product.selected_or_first_available_variant -%}
{%- assign mt_on_sale = false -%}
{%- if mt_variant.compare_at_price > mt_variant.price -%}{%- assign mt_on_sale = true -%}{%- endif -%}
<div class="mt-price-block">
  <p class="mt-price{% if mt_on_sale %} mt-price--sale{% endif %}">
    {%- if mt_on_sale -%}
      <span class="mt-visually-hidden">{{ 'price.regular' | t }}</span>
      <s class="mt-price__old">{{ mt_variant.compare_at_price | money }}</s>
      <span class="mt-visually-hidden">{{ 'price.sale' | t }}</span>
    {%- endif -%}
    {%- if show_from and product.price_varies and variant == blank -%}
      {%- assign mt_from = product.price_min | money -%}
      {{ 'price.from_html' | t: price: mt_from }}
    {%- else -%}
      {{ mt_variant.price | money }}
    {%- endif -%}
  </p>
  {%- if mt_on_sale and settings.mt_legal_lowest_price == 'metafield' -%}
    {%- assign mt_lowest = mt_variant.metafields.mt.lowest_price_30.value | default: product.metafields.mt.lowest_price_30.value -%}
    {%- if mt_lowest != blank -%}
      <p class="mt-price__lowest">{{ 'price.lowest_30' | t }}: {{ mt_lowest | money }}</p>
    {%- elsif request.design_mode -%}
      <p class="mt-price__lowest mt-editor-hint" role="note">{{ 'price.lowest_missing' | t }}</p>
    {%- endif -%}
  {%- endif -%}
  {%- assign mt_is_from = false -%}
  {%- if show_from and product.price_varies and variant == blank -%}{%- assign mt_is_from = true -%}{%- endif -%}
  {%- if settings.mt_legal_unit_price and mt_variant.unit_price_measurement and mt_is_from == false -%}
    <p class="mt-price__unit">{{ 'price.unit_price' | t }}: {{ mt_variant.unit_price | unit_price_with_measurement: mt_variant.unit_price_measurement }}</p>
  {%- endif -%}
  <p class="mt-price__note">
    {%- comment -%}Standardtext/leer > aus Steuer-Einstellung, sonst eigener Text{%- endcomment -%}
    {%- if settings.mt_legal_price_note == blank or settings.mt_legal_price_note == 'inkl. MwSt., zzgl. Versand' -%}
      {%- if cart.taxes_included -%}{{ 'cart.taxes_included' | t }}{%- else -%}{{ 'cart.taxes_excluded' | t }}{%- endif -%}{{ 'price.shipping_suffix' | t }}
    {%- else -%}{{ settings.mt_legal_price_note | escape }}{%- endif -%}
    {%- if shop.shipping_policy.url != blank %} <a href="{{ shop.shipping_policy.url }}">{{ 'price.shipping_link' | t }}</a>{%- endif -%}
  </p>
</div>
