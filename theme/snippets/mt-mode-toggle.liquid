{% comment %}
  Hell/Dunkel-Schalter. Parameter: place = header | footer | account
  Header = nur Icon (44x44), Zustand steht im aria-label/Tooltip. Footer + Konto = mit sichtbarer Zeile.
  Logik > assets/mt-theme.js (aus dem Kern), setzt aria-label, title, data-mode und [data-mt-mode-label]
{% endcomment %}
{%- assign mt_mode_sys = 'general.mode_system' | t -%}
{%- assign mt_mode_text = 'general.mode_label' | t | replace: '%s', mt_mode_sys -%}
<button type="button" class="mt-mode-toggle{% if place == 'header' %} mt-mode-toggle--icon mt-icon-button{% endif %}" data-mt-mode-toggle data-mt-place="{{ place }}"
  data-label-system="{{ 'general.mode_system' | t | escape }}" data-label-light="{{ 'general.mode_light' | t | escape }}" data-label-dark="{{ 'general.mode_dark' | t | escape }}"
  data-label-pattern="{{ 'general.mode_label' | t | escape }}" aria-label="{{ mt_mode_text | escape }}" title="{{ mt_mode_text | escape }}">
  <svg class="mt-mode-ico mt-mode-ico--system" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
  <svg class="mt-mode-ico mt-mode-ico--light" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="mt-mode-ico mt-mode-ico--dark" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
  {%- if place != 'header' -%}
    <span class="mt-mode-toggle__name">{{ 'footer.mode_name' | t }}:</span> <span data-mt-mode-label>{{ 'general.mode_system' | t }}</span>
  {%- endif -%}
</button>
