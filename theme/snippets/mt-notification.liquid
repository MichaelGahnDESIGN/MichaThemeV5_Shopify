{% comment %}
  Notification Glocke > Platzierung aus Theme-Einstellungen (mt_notification_placement)
  Parameter: place = header | footer | floating-bottom-right | floating-bottom-left
  Meldungen kommen aus der MichaThemeV5-App über den App-Proxy (Pfad mt_notification_proxy_path)
  Unsichtbar (hidden), bis assets/mt-notification.js eine gültige Antwort mit mindestens 1 Eintrag hat. Ohne JS oder ohne App sieht niemand eine tote Glocke.
  Anzahl im Panel + Icon > Theme-Einstellungen (mt_notification_limit, mt_notification_icon)
{% endcomment %}
{%- assign mt_n_path = settings.mt_notification_proxy_path | default: '/apps/michatheme-notifications' -%}
{%- assign mt_n_icon = settings.mt_notification_icon | default: 'bell' -%}
<div class="mt-notification mt-notification--{{ place | handleize }}" data-mt-notification data-proxy-path="{{ mt_n_path | escape }}" data-app-api="1"
  data-limit="{{ settings.mt_notification_limit | default: 5 }}"
  data-label="{{ 'notifications.label' | t | escape }}" data-label-unread="{{ 'notifications.label_unread' | t | escape }}"
  data-texts='{"readAll":{{ 'notifications.read_all' | t | json }},"hideRead":{{ 'notifications.hide_read' | t | json }},"hide":{{ 'notifications.hide' | t | json }},"hideLabel":{{ 'notifications.hide_label' | t | json }},"showAll":{{ 'notifications.show_all' | t | json }},"showAllCount":{{ 'notifications.show_all_count' | t | json }},"allTitle":{{ 'notifications.all_title' | t | json }},"close":{{ 'notifications.close' | t | json }},"stateNew":{{ 'notifications.state_new' | t | json }},"stateRead":{{ 'notifications.state_read' | t | json }},"openLink":{{ 'notifications.open_link' | t | json }},"doneRead":{{ 'notifications.done_read' | t | json }},"doneHidden":{{ 'notifications.done_hidden' | t | json }},"error":{{ 'notifications.error' | t | json }},"empty":{{ 'notifications.empty' | t | json }}}'
  data-editor-hint="{% if request.design_mode %}{{ 'notifications.editor_hint' | t | escape }}{% endif %}" hidden>
  <button type="button" class="mt-icon-button mt-notification__button" aria-expanded="false" aria-controls="mt-notification-panel-{{ place | handleize }}" aria-label="{{ 'notifications.label' | t | escape }}">
    {%- comment -%}Icons lokal eingebettet, kein Emoji{%- endcomment -%}
    <svg class="mt-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      {%- case mt_n_icon -%}
        {%- when 'bell-ring' -%}<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/><path d="M4 2C2.8 3.7 2 5.7 2 8"/><path d="M22 8c0-2.3-.8-4.3-2-6"/>
        {%- when 'bell-dot' -%}<path d="M19.4 14.9C20.2 16.4 21 17 21 17H3s3-2 3-9c0-3.3 2.7-6 6-6 .7 0 1.3.1 1.9.3"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/><circle cx="18" cy="8" r="3"/>
        {%- when 'megaphone' -%}<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>
        {%- when 'inbox' -%}<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>
        {%- when 'mail' -%}<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>
        {%- when 'message' -%}<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        {%- when 'info' -%}<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
        {%- when 'star' -%}<path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        {%- when 'sparkles' -%}<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/>
        {%- else -%}<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
      {%- endcase -%}
    </svg>
    <span class="mt-notification__count" data-mt-notification-count aria-hidden="true" hidden>0</span>
  </button>
  <div class="mt-notification__panel" id="mt-notification-panel-{{ place | handleize }}" role="region" aria-label="{{ 'notifications.title' | t | escape }}" hidden>
    <div class="mt-notification__head">
      <strong>{{ 'notifications.title' | t }}</strong>
      <span class="mt-notification__tools">
        <button type="button" class="mt-notification__tool" data-mt-notification-read-all disabled>{{ 'notifications.read_all' | t }}</button>
        <button type="button" class="mt-notification__tool" data-mt-notification-hide-read disabled>{{ 'notifications.hide_read' | t }}</button>
      </span>
    </div>
    <p class="mt-notification__status" data-mt-notification-status role="status" aria-live="polite"></p>
    <p class="mt-notification__empty" data-mt-notification-empty>{{ 'notifications.empty' | t }}</p>
    <ul class="mt-notification__list" data-mt-notification-list></ul>
    <button type="button" class="mt-notification__show-all" data-mt-notification-show-all aria-haspopup="dialog" hidden>{{ 'notifications.show_all' | t }}</button>
  </div>
</div>
