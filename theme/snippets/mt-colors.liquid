{% comment %}Eigene Farben Hell / Dunkel - überschreibt mt-tokens.css, gleiche Selektoren > muss nach den Stylesheets kommen{% endcomment %}
{%- if settings.mt_color_preset == 'custom' -%}
  {%- capture mt_light -%}
    {%- if settings.mt_light_bg != blank -%}--mt-bg: {{ settings.mt_light_bg }};{%- endif -%}
    {%- if settings.mt_light_surface != blank -%}--mt-surface: {{ settings.mt_light_surface }};{%- endif -%}
    {%- if settings.mt_light_text != blank -%}--mt-text: {{ settings.mt_light_text }};{%- endif -%}
    {%- if settings.mt_light_accent != blank -%}
      {%- assign mt_b = settings.mt_light_accent | color_brightness -%}
      {%- comment -%}!important wegen Inline-Style aus mt-init (eigene Akzentfarbe){%- endcomment -%}
      --mt-accent: {{ settings.mt_light_accent }} !important; --mt-accent-hover: {{ settings.mt_light_accent }} !important; --mt-accent-text: {{ settings.mt_light_accent }} !important;
      --mt-on-accent: {% if mt_b > 150 %}#000000{% else %}#ffffff{% endif %} !important;
    {%- endif -%}
  {%- endcapture -%}
  {%- capture mt_dark -%}
    {%- if settings.mt_dark_bg != blank -%}--mt-bg: {{ settings.mt_dark_bg }};{%- endif -%}
    {%- if settings.mt_dark_surface != blank -%}--mt-surface: {{ settings.mt_dark_surface }};{%- endif -%}
    {%- if settings.mt_dark_text != blank -%}--mt-text: {{ settings.mt_dark_text }};{%- endif -%}
    {%- if settings.mt_dark_accent != blank -%}
      {%- assign mt_b = settings.mt_dark_accent | color_brightness -%}
      --mt-accent: {{ settings.mt_dark_accent }} !important; --mt-accent-hover: {{ settings.mt_dark_accent }} !important; --mt-accent-text: {{ settings.mt_dark_accent }} !important;
      --mt-on-accent: {% if mt_b > 150 %}#000000{% else %}#ffffff{% endif %} !important;
    {%- endif -%}
  {%- endcapture -%}
  {%- if mt_light != blank or mt_dark != blank -%}
    <style>
      {%- if mt_light != blank %}
      :root, :root[data-theme="light"] { {{ mt_light }} }
      {%- endif -%}
      {%- if mt_dark != blank %}
      @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { {{ mt_dark }} } }
      :root[data-theme="dark"] { {{ mt_dark }} }
      {%- endif %}
    </style>
  {%- endif -%}
{%- endif -%}
