    "settings_schema": {
        "mt_colors": {
            "name": "Colors",
            "help": "Accent color, mode and custom colors",
            "settings": {
                "mt_color_mode": {
                    "label": "Color mode",
                    "info": "Light, dark or follow the device. Visitors can switch in the shop.",
                    "options__1": {
                        "label": "Like the device"
                    },
                    "options__2": {
                        "label": "Light"
                    },
                    "options__3": {
                        "label": "Dark"
                    }
                },
                "mt_accent": {
                    "label": "Accent color",
                    "info": "Color for buttons, links and highlights. All variants are contrast-checked for light and dark.",
                    "options__1": {
                        "label": "Red"
                    },
                    "options__2": {
                        "label": "Teal"
                    },
                    "options__3": {
                        "label": "Indigo"
                    },
                    "options__4": {
                        "label": "Amber"
                    },
                    "options__5": {
                        "label": "Rose"
                    },
                    "options__6": {
                        "label": "Graphite"
                    }
                },
                "mt_accent_custom": {
                    "label": "Custom accent color",
                    "info": "Leave empty to use the accent color above. Note: custom colors are not contrast-checked automatically."
                },
                "mt_mode_toggle": {
                    "label": "Show light/dark switch",
                    "info": "Off = no switch in the shop. Choose below where it appears."
                },
                "mt_mode_toggle_place": {
                    "label": "Place of the light/dark switch",
                    "info": "Header = icon in the icon bar (default). Footer = row in the footer. Customer account: Shopify manages customer accounts itself, so the theme cannot add anything there. The switch then appears as a row in the footer.",
                    "options__1": {
                        "label": "Header"
                    },
                    "options__2": {
                        "label": "Footer"
                    },
                    "options__3": {
                        "label": "Customer account settings"
                    }
                },
                "mt_color_preset": {
                    "label": "Color preset",
                    "info": "“Basic” uses the checked theme colors. “Basic with custom colors” applies the colors under “Expert”, separately for light and dark; empty fields keep the basic color.",
                    "options__1": {
                        "label": "Basic (checked colors)"
                    },
                    "options__2": {
                        "label": "Basic with custom colors"
                    }
                },
                "mt_light_bg": {
                    "label": "Light: background",
                    "info": "Custom colors are not contrast-checked automatically (WCAG AA: text at least 4.5:1)."
                },
                "mt_light_surface": {
                    "label": "Light: surfaces (cards, header, footer)"
                },
                "mt_light_text": {
                    "label": "Light: text"
                },
                "mt_light_accent": {
                    "label": "Light: accent",
                    "info": "Replaces the accent color and the custom accent color in light mode. Button text is set to black or white."
                },
                "mt_dark_bg": {
                    "label": "Dark: background"
                },
                "mt_dark_surface": {
                    "label": "Dark: surfaces (cards, header, footer)"
                },
                "mt_dark_text": {
                    "label": "Dark: text"
                },
                "mt_dark_accent": {
                    "label": "Dark: accent",
                    "info": "Replaces the accent color in dark mode."
                }
            }
        },
