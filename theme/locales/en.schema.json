        "mt_legal": {
            "name": "Legal",
            "help": "Price information and mandatory texts",
            "settings": {
                "mt_legal_price_note": {
                    "label": "Note next to the price",
                    "info": "Mandatory information (price indication rules). The link to the shipping costs always stays."
                },
                "mt_legal_unit_price": {
                    "label": "Show unit price",
                    "info": "Mandatory where price indication rules require a unit price."
                },
                "mt_legal_shipping_time": {
                    "label": "Delivery time",
                    "info": "Default for all products, for example “Delivery time: 2–4 working days”. Only enter what you really keep. Can be overridden per product with the product metafield mt.lieferzeit (single line text). Empty = no information."
                },
                "mt_legal_lowest_price": {
                    "label": "Lowest price of the last 30 days for strike-through prices",
                    "info": "Shopify does not store a price history. Maintain the value in the metafield mt.lowest_price_30 (type money, on the variant or product). If it is missing for a strike-through price, a note appears in the theme editor only. Technical note, not legal advice.",
                    "options__1": {
                        "label": "Show from metafield"
                    },
                    "options__2": {
                        "label": "Do not show"
                    }
                },
                "mt_legal_warranty": {
                    "label": "Note on the statutory warranty",
                    "info": "On the product page and in the cart."
                },
                "mt_legal_warranty_text": {
                    "label": "Warranty text",
                    "info": "Suggested text, have it checked legally."
                },
                "mt_legal_gpsr": {
                    "label": "Product safety (GPSR) on the product page",
                    "info": "Reads the product metafields gpsr.manufacturer (manufacturer), gpsr.responsible_person (responsible person in the EU), gpsr.contact (contact) and gpsr.safety_info (safety information), each multi-line text. Without values nothing appears."
                },
                "mt_legal_withdrawal_page": {
                    "label": "Page “Withdraw from contract”",
                    "info": "Linked in the footer. The page should contain the withdrawal form or function. The order button is labeled by Shopify checkout, not by the theme."
                }
            }
        },
        "mt_a11y": {
            "name": "Accessibility",
            "help": "Focus, text size, motion",
