{% comment %}
  Layout der Passwortseite (Shop noch nicht geöffnet). Gleiche Assets wie theme.liquid, ohne Header und Footer.
  Siehe https://shopify.dev/docs/storefronts/themes/architecture/layouts
{% endcomment %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>document.documentElement.className += ' mt-js';</script>
    {%- render 'mt-config' -%}
    {%- render 'mt-init' -%}
    {%- render 'mt-fonts' -%}
    <title>{{ shop.name | escape }}</title>
    {{ 'mt-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'mt-base.css' | asset_url | stylesheet_tag }}
    {{ 'mt-shopify.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="mt-template-password">
    <a class="mt-skip" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>
    <main id="MainContent" class="mt-main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    <script src="{{ 'mt-shopify.js' | asset_url }}" defer></script>
  </body>
</html>
