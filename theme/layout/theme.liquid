{% comment %}
  MichaThemeV5 für Shopify (Online Store 2.0). Layout für alle Seiten außer Passwortseite und Kasse.
  Struktur: https://shopify.dev/docs/storefronts/themes/architecture/layouts
  Keine externen Ressourcen: Schriften, CSS und JS liegen in assets/. Cookie-Banner: nicht Teil des Themes (siehe README).
  Lizenz: proprietär, Michael Gahn DESIGN (https://theme.michael-gahn.de). Schriften: SIL Open Font License 1.1 (snippets/mt-font-licenses.liquid).
{% endcomment %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <script>document.documentElement.className += ' mt-js';</script>
    {%- render 'mt-config' -%}
    {%- render 'mt-init' -%}
    {%- render 'mt-fonts' -%}
    {%- comment -%}Lizenztexte der lokalen Schriften (gibt nichts aus){%- endcomment -%}
    {%- render 'mt-font-licenses' -%}
    {%- if settings.mt_favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.mt_favicon | image_url: width: 48, height: 48 }}">
    {%- endif -%}
    <title>{{ page_title | escape }}{% if current_page != 1 %} – {{ 'general.page_n' | t: n: current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name | escape }}{% endunless %}</title>
    {%- render 'mt-meta' -%}
    {{ 'mt-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'mt-base.css' | asset_url | stylesheet_tag }}
    {{ 'mt-shopify.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="mt-template-{{ request.page_type | handleize }}">
    <a class="mt-skip" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    {%- comment -%}Notification Glocke (Menü + schwebend) > sections/mgd-notification-center.liquid{%- endcomment -%}
    {%- unless settings.mgd_notification_placement == 'footer' or settings.mgd_notification_placement == 'none' -%}
      {% section 'mgd-notification-center' %}
    {%- endunless -%}
    <main id="MainContent" class="mt-main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {%- comment -%}Notification Glocke im Footer{%- endcomment -%}
    {%- if settings.mgd_notification_placement == 'footer' -%}
      {% section 'mgd-notification-center' %}
    {%- endif -%}
    <script src="{{ 'mt-shopify.js' | asset_url }}" defer></script>
  </body>
</html>
