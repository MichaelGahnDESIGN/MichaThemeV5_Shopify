{% comment %}
  MichaThemeV5 Shopify - Layout alle Seiten außer Passwort + Kasse
  alles lokal > assets/, kein Cookie-Banner im Theme (README)
  Lizenz proprietär Michael Gahn DESIGN (https://theme.michael-gahn.de), Schriften OFL 1.1 > snippets/mt-font-licenses.liquid
{% endcomment %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <script>document.documentElement.className += ' mt-js';</script>
    {%- render 'mt-config' -%}
    {%- render 'mt-init' -%}
    {%- render 'mt-fonts' -%}
    {%- comment -%}Lizenztexte der lokalen Schriften (gibt nichts aus){%- endcomment -%}
    {%- render 'mt-font-licenses' -%}
    {%- if settings.mt_favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.mt_favicon | image_url: width: 48, height: 48 }}">
    {%- endif -%}
    {%- if settings.mt_touch_icon != blank -%}
      <link rel="apple-touch-icon" href="{{ settings.mt_touch_icon | image_url: width: 180, height: 180, crop: 'center' }}">
    {%- endif -%}
    <title>{{ page_title | escape }}{% if current_page != 1 %} – {{ 'general.page_n' | t: n: current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name | escape }}{% endunless %}</title>
    {%- render 'mt-meta' -%}
    {{ 'mt-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'mt-base.css' | asset_url | stylesheet_tag }}
    {{ 'mt-shopify.css' | asset_url | stylesheet_tag }}
    {%- if settings.mt_notification_placement != 'none' -%}
      {{ 'mt-notification.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- render 'mt-colors' -%}
    {%- render 'mt-jsonld' -%}
    {{ content_for_header }}
  </head>
  <body class="mt-template-{{ request.page_type | handleize }}">
    <a class="mt-skip" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" class="mt-main" tabindex="-1">
      {%- render 'mt-breadcrumbs' -%}
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <script src="{{ 'mt-shopify.js' | asset_url }}" defer></script>
    {%- comment -%}Notification Glocke > snippets/mt-notification.liquid (Kopfzeile + Footer rendern die Sections selbst){%- endcomment -%}
    {%- if settings.mt_notification_placement != 'none' -%}
      {%- if settings.mt_notification_placement contains 'floating' -%}
        {%- render 'mt-notification', place: settings.mt_notification_placement -%}
      {%- endif -%}
      <script src="{{ 'mt-notification.js' | asset_url }}" defer></script>
    {%- endif -%}
  </body>
</html>
