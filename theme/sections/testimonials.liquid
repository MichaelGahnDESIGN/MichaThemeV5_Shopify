{% comment %}Kundenstimmen nur als Text, keine Fremd-Widgets. Nur echte Stimmen (UWG) - Hinweis zur Prüfung über note{% endcomment %}
<section class="mt-section mt-testimonials" aria-labelledby="mt-tm-{{ section.id }}">
  <h2 id="mt-tm-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  <ul class="mt-testimonials__list" role="list">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        <figure class="mt-testimonial">
          <blockquote class="mt-testimonial__quote"><p>{{ block.settings.quote | escape | newline_to_br }}</p></blockquote>
          {%- if block.settings.author != blank -%}<figcaption class="mt-testimonial__author">{{ block.settings.author | escape }}</figcaption>{%- endif -%}
        </figure>
      </li>
    {%- endfor -%}
  </ul>
  {%- if section.settings.note != blank -%}<p class="mt-form__hint">{{ section.settings.note | escape }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "settings": [
    { "type": "paragraph", "content": "t:sections.testimonials.settings.info.content" },
    { "type": "text", "id": "heading", "label": "t:sections.testimonials.settings.heading.label", "default": "Kundenstimmen" },
    { "type": "text", "id": "note", "label": "t:sections.testimonials.settings.note.label", "info": "t:sections.testimonials.settings.note.info" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "t:sections.testimonials.blocks.quote.name",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "t:sections.testimonials.blocks.quote.settings.quote.label", "default": "Hier steht eine echte Rückmeldung einer Kundin oder eines Kunden." },
        { "type": "text", "id": "author", "label": "t:sections.testimonials.blocks.quote.settings.author.label", "default": "Vorname, Ort" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    { "name": "t:sections.testimonials.name", "blocks": [ { "type": "quote" }, { "type": "quote" }, { "type": "quote" } ] }
  ]
}
{% endschema %}
