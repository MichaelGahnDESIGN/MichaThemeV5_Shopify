{% comment %}Bild mit Text, Bild links oder rechts. Bild dekorativ (alt leer), Text trägt die Info{% endcomment %}
<section class="mt-section mt-image-text mt-image-text--{{ section.settings.image_position }}" aria-labelledby="mt-it-{{ section.id }}">
  <div class="mt-image-text__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'mt-image-text__img', widths: '400, 600, 900, 1200', sizes: '(min-width: 64rem) 50vw, 100vw', loading: 'lazy', alt: '' }}
    {%- else -%}
      <span class="mt-image-text__placeholder"></span>
    {%- endif -%}
  </div>
  <div class="mt-image-text__body">
    <h2 id="mt-it-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <div class="mt-rte">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <p><a class="mt-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image_text.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.image_text.settings.image.label" },
    {
      "type": "select", "id": "image_position", "label": "t:sections.image_text.settings.image_position.label", "default": "left",
      "options": [
        { "value": "left", "label": "t:sections.image_text.settings.image_position.options__1.label" },
        { "value": "right", "label": "t:sections.image_text.settings.image_position.options__2.label" }
      ]
    },
    { "type": "text", "id": "heading", "label": "t:sections.image_text.settings.heading.label", "default": "Über uns" },
    { "type": "richtext", "id": "text", "label": "t:sections.image_text.settings.text.label", "default": "<p>Erzählen Sie hier, wofür Ihr Shop steht.</p>" },
    { "type": "text", "id": "button_label", "label": "t:sections.image_text.settings.button_label.label", "default": "Mehr erfahren" },
    { "type": "url", "id": "button_link", "label": "t:sections.image_text.settings.button_link.label" }
  ],
  "presets": [ { "name": "t:sections.image_text.name" } ]
}
{% endschema %}
