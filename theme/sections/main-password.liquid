<div class="mt-container mt-page mt-password">
  <h1>{{ shop.name | escape }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message | escape }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'mt-form' -%}
    {%- if form.errors -%}<div class="mt-alert mt-alert--danger" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="mt-field">
      <label for="mt-password">{{ 'password.label' | t }}</label>
      <input type="password" id="mt-password" name="password" autocomplete="current-password" required aria-required="true">
    </div>
    <button type="submit" class="mt-btn">{{ 'password.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": []
}
{% endschema %}
