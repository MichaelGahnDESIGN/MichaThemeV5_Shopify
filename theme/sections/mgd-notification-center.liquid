{%- comment -%}Notification Center Glocke. Platzierung + App-Proxy-Pfad kommen aus den Theme-Einstellungen (settings_schema > MichaThemeV5 Notification Center){%- endcomment -%}
{%- assign mgd_placement = settings.mgd_notification_placement | default: 'menu' -%}
{%- assign mgd_proxy_path = settings.mgd_notification_proxy_path | default: '/apps/michatheme-notifications' -%}
{%- if mgd_placement != 'none' -%}
{{ 'mgd-notification-center.css' | asset_url | stylesheet_tag }}
<div class="mgd-notification-center mgd-notification-center--{{ mgd_placement | handleize }}" data-mgd-notification-center data-proxy-path="{{ mgd_proxy_path | escape }}" data-app-api="1"><button type="button" class="mgd-notification-center__button" aria-expanded="false" aria-controls="mgd-notification-panel-{{ section.id }}" aria-label="Benachrichtigungen öffnen"><span aria-hidden="true">🔔</span><span class="mgd-notification-center__count" hidden>0</span></button><section id="mgd-notification-panel-{{ section.id }}" class="mgd-notification-center__panel" hidden aria-label="Benachrichtigungen"><p class="mgd-notification-center__empty">Keine neuen Benachrichtigungen.</p><ul></ul></section></div>
<script src="{{ 'mgd-notification-center.js' | asset_url }}" defer></script>
{%- endif -%}
{% schema %}{"name":"Notification Center","settings":[{"type":"paragraph","content":"Platzierung und App-Proxy-Pfad stehen in den Theme-Einstellungen unter MichaThemeV5 Notification Center."}]}{% endschema %}
