{% comment %}FAQ als <details>, geht ohne JS. Optional FAQPage JSON-LD (nur wenn SEO > JSON-LD an){% endcomment %}
<section class="mt-section mt-faq" aria-labelledby="mt-faq-{{ section.id }}">
  <h2 id="mt-faq-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  <div class="mt-panels">
    {%- for block in section.blocks -%}
      <details class="mt-panel" {{ block.shopify_attributes }}>
        <summary class="mt-panel__title">{{ block.settings.question | escape }}</summary>
        <div class="mt-panel__body mt-rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>
{%- if section.settings.jsonld and settings.mt_seo_jsonld and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {%- if forloop.index > 1 -%},{%- endif %}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} } }
        {%- endfor %}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.faq.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.faq.settings.heading.label", "default": "Häufige Fragen" },
    { "type": "checkbox", "id": "jsonld", "label": "t:sections.faq.settings.jsonld.label", "info": "t:sections.faq.settings.jsonld.info", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.blocks.question.name",
      "settings": [
        { "type": "text", "id": "question", "label": "t:sections.faq.blocks.question.settings.question.label", "default": "Ihre Frage" },
        { "type": "richtext", "id": "answer", "label": "t:sections.faq.blocks.question.settings.answer.label", "default": "<p>Ihre Antwort.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "t:sections.faq.name", "blocks": [ { "type": "question" }, { "type": "question" }, { "type": "question" } ] }
  ]
}
{% endschema %}
